# GI Core environment for contract/compose.contract.yml (gi-migrate and gi-core).
#
# TEST-ONLY VALUES. This stack runs on a throwaway database (tmpfs) and is
# published on 127.0.0.1 only; nothing here is, or may become, a production
# secret. Required keys come from the backend's apps/gi-core/src/config/
# env.validation.ts (DATABASE_URL and JWT_ACCESS_SECRET are the only
# `.required()` ones, plan §17.3); the rest are set explicitly so the stack does
# not depend on NODE_ENV=production defaults.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
LOG_LEVEL=info

# Must match POSTGRES_* of the postgres service in compose.contract.yml.
DATABASE_URL=postgresql://gi:contract-only-db-password@postgres:5432/gi_home?schema=public

# ≥ 32 characters (Joi .min(32)). Test-only.
JWT_ACCESS_SECRET=contract-only-jwt-secret-0123456789abcdef
GI_EDGE_CREDENTIAL_ENCRYPTION_KEY=contract-only-edge-key-0123456789abcdef

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=gi_refresh_token
# Plain HTTP on loopback, like the dev stack and the Pi (plan §3.5).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_MAX_ACTIVE_SESSIONS=10

# Swagger explicitly on: /docs and /docs-json feed the spec drift check (§17.5).
SWAGGER_ENABLED=true

# No reverse proxy in front of this Core: the client IP (login rate limit,
# 5/min) is the socket peer, not an X-Forwarded-For header.
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000

# No HTTP_PROXY / NODE_OPTIONS=--use-env-proxy (unlike the dev compose): GI Core
# reaches fake-esphome directly on the project network (plan §17.3).

# GI Edge auto-activation (gi-edge-auto-activation.service.ts) tells the device
# where to activate with this URL. Without it the URL is derived from the host's
# first IPv4 and port 80, which is wrong inside this stack: GI Core listens on
# 3000 and the simulator reaches it through the mosquitto service.
GI_EDGE_ACTIVATION_BASE_URL=http://mosquitto:3000
